{
  "name": "inference-deployment-calculator",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "test": "pnpm data:build && vitest run",
    "typecheck": "pnpm data:build && pnpm -r exec tsc -b",
    "data:build": "tsx packages/data/src/build.ts",
    "data:import": "tsx packages/data/src/hf-import.ts",
    "calibrate": "tsx packages/data/src/calibrate.ts",
    "web:dev": "pnpm --filter @nchc/web dev",
    "web:build": "pnpm --filter @nchc/web build",
    "web:e2e": "pnpm --filter @nchc/web exec playwright test"
  },
  "devDependencies": {
    "@types/node": "25.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  }
}
